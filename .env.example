# FarmShield — Environment Variables
# Copy this file to .env and fill in the values.
# The backend reads these at startup via os.getenv().

# ─── Database ────────────────────────────────────────────────
# Local development default: SQLite file in backend/
# Override for production (Render auto-sets RENDER=true and uses /var/data/)
DATABASE_URL=sqlite:///./farmshield.db

# ─── Server ──────────────────────────────────────────────────
# Host and port for uvicorn (defaults work for local dev)
HOST=127.0.0.1
PORT=8000

# ─── CORS ────────────────────────────────────────────────────
# Production: restrict to your frontend origin
# Example: ALLOWED_ORIGINS=https://farmshield.app,https://www.farmshield.app
# Hackathon / dev: leave as * to allow all origins
ALLOWED_ORIGINS=*

# ─── ML Model ────────────────────────────────────────────────
# Path to the ONNX model (relative to backend/).
# Default: model_store/plantvillage_mobilenetv2.onnx
# If not present, backend falls back gracefully to DEMO_SIMULATION mode.
# MODEL_PATH=model_store/plantvillage_mobilenetv2.onnx
